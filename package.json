{
  "name": "kjv-reader",
  "version": "0.0.0",
  "scripts": {
    "prepare:client-db-assets": "node scripts/prepare-client-db-assets.mjs",
    "prestart": "npm run prepare:client-db-assets",
    "prebuild": "npm run prepare:client-db-assets",
    "prewatch": "npm run prepare:client-db-assets",
    "build:pwa": "npm run prepare:client-db-assets && ng build --configuration production",
    "serve:pwa": "node scripts/serve-dist.mjs dist/kjv-reader/browser 4200",
    "start:pwa": "npm run build:pwa && npm run serve:pwa",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run kjv-reader:storybook",
    "build-storybook": "ng run kjv-reader:build-storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/service-worker": "^21.1.0",
    "@angular/router": "^21.1.0",
    "sql.js": "^1.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "storybook": "^10.2.8",
    "@storybook/angular": "^10.2.8",
    "@angular-devkit/build-angular": "^21.1.0",
    "@angular-devkit/architect": "^0.2101.0",
    "@angular-devkit/core": "^21.1.0",
    "@angular/platform-browser-dynamic": "^21.1.0"
  }
}
