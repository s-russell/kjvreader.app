{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/favicon.ico"
        ]
      }
    },
    {
      "name": "sqlite-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/kjv.sqlite",
          "/assets/sql.js/sql-wasm.js",
          "/assets/sql.js/sql-wasm.wasm"
        ]
      }
    }
  ]
}
